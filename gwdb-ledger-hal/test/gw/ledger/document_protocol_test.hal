(ns gw.ledger.document-protocol-test
  (:require [gw.ledger.document-protocol :as document]))

(def results
  (let [operations [{:kind :append :value "a"}
                    {:kind :append :value "b"}]
        fixture-root
        (fn [value]
          (if (map? value)
            (if (= (get value :value) "a")
              "operation-a"
              "operation-b")
            (if (= value "a")
              "document-a"
              "document-ab")))
        replayed
        (document/replay-batch
         (fn [value operation] (str value (get operation :value)))
         fixture-root
         ""
         operations)
        batch
        (document/change-batch
         "batch" "log" 2 "previous" "revision" "base" "result"
         "profile" "delegation" operations)]
    [(test-check "frames domain-separated signing bytes"
                 (document/signing-payload "change-batch" "root")
                 (str "GWDP0" \0 "change-batch" \0 "root"))
     (test-check "stores operations in one batch without hiding replay boundaries"
                 [(get batch :operations)
                  (get replayed :document)
                  (get replayed :states)]
                 [operations
                  "ab"
                  [{:index 0 :operation-root "operation-a"
                    :result-root "document-a"}
                   {:index 1 :operation-root "operation-b"
                    :result-root "document-ab"}]])
     (test-check "enforces the compact batch bound"
                 [(document/batch-valid? [])
                  (document/batch-valid? operations)]
                 [false true])
     (test-check "returns explicit booleans for terminal dispositions"
                 [(document/terminal-disposition? :accepted)
                  (document/terminal-disposition? :resolved)
                  (document/terminal-disposition? :rejected)
                  (document/terminal-disposition? :abandoned)
                  (document/terminal-disposition? :conflict)
                  (document/terminal-disposition? nil)]
                 [true true true true false false])
     (test-check "blocks delivery until every disclosed batch is terminal"
                 [(document/delivery-ready? [:accepted :resolved :abandoned])
                  (document/delivery-ready? [:accepted :conflict])
                  (document/delivery-ready? [])]
                 [true false true])]))

results
