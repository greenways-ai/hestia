 :migration/separate-later
 [{:source "gw-fabric/"
   :reason "Hara runtime coordination is neither the Ignatius chain nor a Hestia application."}]

 :migration/generated-dependency
 {:source "migrations/20260801112956_ledger_schema.sql"
  :owner ignatius
  :hestia-action :replace-with-pinned-install
  :rule "Hestia must not retain or edit a copied generic chain schema after the Ignatius SQL artefact is published."}

 :migration/stages
 [{:stage :create-target-repository :status :complete}
  {:stage :freeze-canonical-fixtures :status :in-progress}
  {:stage :extract-complete-components :status :complete}
  {:stage :port-ledger-conformance-to-hal :status :in-progress}
  {:stage :publish-chain-dependency :status :pending
   :issue "greenways-ai/ignatius#76"}
  {:stage :switch-hestia-to-pinned-dependency :status :pending
   :issue "greenways-ai/hestia#28"}
  {:stage :migrate-existing-canonical-data :status :pending
   :issue "greenways-ai/hestia#28"}
  {:stage :remove-compatibility-copies :status :pending
   :requires [:backup-restore :replay :rollback :integrity-verification]}]

 :migration/invariants
 ["Ignatius imports no Hestia namespace."
  "Hestia writes canonical state only through the Ignatius HAL client and postgres.core capability."
  "Ignatius PostgreSQL execution and block commitment are authoritative."
  "Portable execution is local evaluation and conformance, not a replacement chain."
  "No HTTP node or separate PostgreSQL provider sits between Hestia and Ignatius."
  "Hestia projections are rebuildable from Ignatius records and receipts."
  "Portable HAL and PostgreSQL agree on frozen canonical fixtures."
  "Documents, rooms and continuity version independently of Ignatius."]}
