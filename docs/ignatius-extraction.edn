{:migration/id ignatius-from-hestia-v1
 :migration/source "greenways-ai/hestia"
 :migration/target "greenways-ai/ignatius"
 :migration/decision
 "Ignatius owns the authoritative PostgreSQL blockchain and its portable HAL
 client, local evaluator, generic workflow manager, and postgres.core host
 contracts. Hestia owns
 agent authority, rooms, documents, continuity, application projections,
 services, and product experiences."

 :migration/move
 [{:source "gwdb-ledger/"
   :target "db/"
   :mode :history-preserving
   :owner ignatius}
  {:source "web-components/gw-ledger-sha/"
   :target "extensions/sha/"
   :mode :history-preserving
   :owner ignatius}
  {:source "web-components/gw-ledger-noir/"
   :target "extensions/noir/"
   :mode :history-preserving
   :owner ignatius}
  {:source "gwdb-ledger-hal/src/gw/ledger/codec.hal"
   :target "hal/src/ignatius/codec.hal"
   :mode :history-preserving
   :compatibility-namespace gw.ledger.codec
   :owner ignatius}
  {:source "gwdb-ledger-hal/src/gw/ledger/runtime.hal"
   :target "hal/src/ignatius/runtime.hal"
   :mode :history-preserving
   :compatibility-namespace gw.ledger.runtime
   :owner ignatius}
  {:source "gwdb-ledger-hal/src/gw/ledger/transaction.hal"
   :target "hal/src/ignatius/transaction.hal"
   :mode :history-preserving
   :compatibility-namespace gw.ledger.transaction
   :owner ignatius}
  {:source "gwdb-ledger-hal/src/gw/ledger/offline.hal"
   :target "hal/src/ignatius/client/outbox.hal"
   :mode :history-preserving
   :compatibility-namespace gw.ledger.offline
   :owner ignatius}
  {:source "gwdb-ledger-hal/test/gw/ledger/offline_test.hal"
   :target "hal/test/ignatius/client/outbox_test.hal"
   :mode :history-preserving
   :owner ignatius}]

 :migration/split
 [{:source "services/agent-gateway/"
   :ignatius-owns
   [:canonical-pack-transport
    :generic-transaction-admission
    :chain-transaction-inputs
    :chain-receipt-lookup
    :chain-sync
    :postgres-core-integration]
   :hestia-owns
   [:hestia-record-kinds
    :agent-and-room-proofs
    :document-transformation
    :hestia-environment-policy
    :application-receipt-presentation
    :application-http-resources]}
  {:source "browser/"
   :ignatius-package "@greenways/ignatius-client"
   :ignatius-owns
   [:canonical-encoding
    :transaction-construction
    :chain-signing-payloads
    :outbox
    :receipt-validation
    :postgres-core-client]
   :hestia-package "@greenways/hestia-client"
   :hestia-owns
   [:agent-records
    :rooms
    :documents
    :continuity
    :application-storage]}]

