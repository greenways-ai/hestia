#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$repo_root"

fixture="$(mktemp)"
project="hestia-agent-verification-ci"
compose=(docker compose --project-name "$project" --env-file .hestia/env -f compose.yaml)

cleanup() {
  rm -f "$fixture"
  if [[ -f .hestia/env ]]; then
    "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

scripts/hestia init >/dev/null
# shellcheck disable=SC1091
source .hestia/env

"${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
"${compose[@]}" up --detach --build postgres

ready=false
for _ in $(seq 1 90); do
  if "${compose[@]}" exec -T postgres \
       pg_isready -U postgres -d hestia >/dev/null 2>&1 \
     && "${compose[@]}" exec -T postgres \
       test -f /var/lib/postgresql/data/.hestia-migrations-complete \
       >/dev/null 2>&1; then
    ready=true
    break
  fi
  sleep 1
done
if [[ "$ready" != true ]]; then
  "${compose[@]}" logs postgres >&2
  echo "Hestia PostgreSQL did not complete initialization" >&2
  exit 1
fi

node browser/test-support/agent-record-fixture.mjs create "$fixture"
get_fixture() {
  node browser/test-support/agent-record-fixture.mjs get "$fixture" "$1"
}

environment_id="$(get_fixture environment_id)"
environment_public_key_hex="$(get_fixture environment_public_key_hex)"
signed_record_root_hex="$(get_fixture signed_record_root_hex)"
record_kind="$(get_fixture record_kind)"
cell_count="$(get_fixture cell_count)"
pack_hex="$(get_fixture pack_hex)"

postgres_psql() {
  "${compose[@]}" exec -T postgres \
    psql --no-psqlrc --set=ON_ERROR_STOP=1 --username postgres --dbname hestia "$@"
}

app_psql() {
  "${compose[@]}" exec -T -e PGPASSWORD="$HESTIA_APP_PASSWORD" postgres \
    psql --no-psqlrc --set=ON_ERROR_STOP=1 --host 127.0.0.1 \
      --username hestia_app --dbname hestia "$@"
}

# psql does not interpolate :'name' variables in a server --command string.
# Feed SQL through stdin so psql performs variable expansion before dispatch.
postgres_psql \
  --set=environment_id="$environment_id" \
  --set=public_key_hex="$environment_public_key_hex" \
  >/dev/null <<'SQL'
SELECT encode(
  hestia.environment_signer_register(
    :'environment_id',
    decode(:'public_key_hex', 'hex')
  ),
  'hex'
);
SQL

prepare_output="$(
  app_psql --tuples-only --no-align --field-separator='|' \
    --set=environment_id="$environment_id" \
    --set=pack_hex="$pack_hex" \
    --set=cell_count="$cell_count" \
    --set=record_root_hex="$signed_record_root_hex" \
    --set=record_kind="$record_kind" <<'SQL'
SELECT
  sequence,
  encode(body_root, 'hex'),
  encode(signer_key_root, 'hex'),
  encode(verification_receipt_root, 'hex'),
  encode(receipt_signing_payload, 'hex')
FROM hestia.agent_record_verify_prepare(
  :'environment_id',
  decode(:'pack_hex', 'hex'),
  :'cell_count'::bigint,
  decode(:'record_root_hex', 'hex'),
  :'record_kind'
);
SQL
)"

IFS='|' read -r verification_sequence body_root_hex signer_key_root_hex receipt_root_hex receipt_payload_hex <<<"$prepare_output"
for value in "$body_root_hex" "$signer_key_root_hex" "$receipt_root_hex"; do
  if [[ ! "$value" =~ ^[0-9a-f]{64}$ ]]; then
    echo "PostgreSQL returned an invalid HCV1 root: $value" >&2
    exit 1
  fi
done
if [[ ! "$verification_sequence" =~ ^[1-9][0-9]*$ ]]; then
  echo "PostgreSQL returned an invalid verification sequence" >&2
  exit 1
fi

receipt_signature_hex="$(
  node browser/test-support/agent-record-fixture.mjs sign "$fixture" "$receipt_payload_hex"
)"
if [[ ! "$receipt_signature_hex" =~ ^[0-9a-f]{128}$ ]]; then
  echo "fixture produced an invalid Ed25519 receipt signature" >&2
  exit 1
fi

signed_receipt_root_hex="$(
  app_psql --tuples-only --no-align \
    --set=environment_id="$environment_id" \
    --set=record_root_hex="$signed_record_root_hex" \
    --set=signature_hex="$receipt_signature_hex" <<'SQL'
SELECT encode(
  hestia.agent_record_verify_commit(
    :'environment_id',
    decode(:'record_root_hex', 'hex'),
    decode(:'signature_hex', 'hex')
  ),
  'hex'
);
SQL
)"
if [[ ! "$signed_receipt_root_hex" =~ ^[0-9a-f]{64}$ ]]; then
  echo "PostgreSQL returned an invalid signed receipt root" >&2
  exit 1
fi

verified_status="$(
  app_psql --tuples-only --no-align \
    --set=record_root_hex="$signed_record_root_hex" <<'SQL'
SELECT status || '|' || encode(signed_receipt_root, 'hex')
FROM hestia.agent_record_verification
WHERE signed_record_root = decode(:'record_root_hex', 'hex');
SQL
)"
if [[ "$verified_status" != "verified|$signed_receipt_root_hex" ]]; then
  echo "verification projection does not match the signed receipt" >&2
  exit 1
fi

idempotent_receipt="$(
  app_psql --tuples-only --no-align \
    --set=environment_id="$environment_id" \
    --set=pack_hex="$pack_hex" \
    --set=cell_count="$cell_count" \
    --set=record_root_hex="$signed_record_root_hex" \
    --set=record_kind="$record_kind" <<'SQL'
SELECT encode(verification_receipt_root, 'hex')
FROM hestia.agent_record_verify_prepare(
  :'environment_id',
  decode(:'pack_hex', 'hex'),
  :'cell_count'::bigint,
  decode(:'record_root_hex', 'hex'),
  :'record_kind'
);
SQL
)"
if [[ "$idempotent_receipt" != "$receipt_root_hex" ]]; then
  echo "idempotent verification returned another receipt" >&2
  exit 1
fi

if app_psql \
  --set=environment_id="$environment_id" \
  --set=pack_hex="$pack_hex" \
  --set=cell_count="$cell_count" \
  --set=record_root_hex="$signed_record_root_hex" \
  >/dev/null 2>&1 <<'SQL'
SELECT *
FROM hestia.agent_record_verify_prepare(
  :'environment_id',
  decode(:'pack_hex', 'hex'),
  :'cell_count'::bigint,
  decode(:'record_root_hex', 'hex'),
  'negotiation/offer'
);
SQL
then
  echo "record kind substitution was accepted" >&2
  exit 1
fi

if app_psql --command="INSERT INTO hestia.agent_record_verification DEFAULT VALUES;" \
  >/dev/null 2>&1; then
  echo "hestia_app received a forbidden direct projection write" >&2
  exit 1
fi

printf 'verified agent record %s with signed receipt %s\n' \
  "$signed_record_root_hex" "$signed_receipt_root_hex"
