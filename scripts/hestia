#!/usr/bin/env bash
set -euo pipefail

umask 077

repo_root="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
state_dir="$repo_root/.hestia"
env_file="$state_dir/env"
compose_file="$repo_root/compose.yaml"

die() {
  echo "hestia: $*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

initialize() {
  need openssl
  if [[ -f "$env_file" ]]; then
    if ! grep -q '^HESTIA_PGSODIUM_ROOT_KEY=' "$env_file"; then
      echo "HESTIA_PGSODIUM_ROOT_KEY=$(openssl rand -hex 32)" >> "$env_file"
      chmod 600 "$env_file"
      echo "Added a private pgSodium root key to existing operator state."
    fi
    echo "Hestia is already initialized."
    return
  fi
  install -d -m 700 "$state_dir"
  {
    echo "HESTIA_POSTGRES_PASSWORD=$(openssl rand -hex 32)"
    echo "HESTIA_APP_PASSWORD=$(openssl rand -hex 32)"
    echo "HESTIA_PGSODIUM_ROOT_KEY=$(openssl rand -hex 32)"
    echo "HESTIA_JWT_SECRET=$(openssl rand -hex 48)"
    echo "HESTIA_TURN_SECRET=$(openssl rand -hex 32)"
    echo "HESTIA_SITE_URL=http://127.0.0.1:58080"
    echo "HESTIA_GITHUB_ENABLED=false"
    echo "HESTIA_GITHUB_CLIENT_ID="
    echo "HESTIA_GITHUB_SECRET="
  } > "$env_file"
  chmod 600 "$env_file"
  echo "Initialized private operator state in $state_dir"
}

compose_command() {
  if docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  elif command -v docker-compose >/dev/null 2>&1; then
    docker-compose "$@"
  else
    die "Docker Compose plugin or docker-compose is required"
  fi
}

compose() {
  [[ -f "$env_file" ]] || die "run scripts/hestia init first"
  compose_command --project-name hestia --env-file "$env_file" --file "$compose_file" "$@"
}

command="${1:-help}"
shift || true

case "$command" in
  init)
    initialize
    ;;
  doctor)
    need docker
    need openssl
    need psql
    need pg_dump
    need pg_restore
    compose_command version >/dev/null
    docker info >/dev/null
    [[ -f "$env_file" ]] || die "run scripts/hestia init"
    compose config --quiet
    echo "Hestia prerequisites and Compose configuration are ready."
    ;;
  up)
    initialize
    compose up --detach --build "$@"
    ;;
  down)
    compose down
    ;;
  status)
    compose ps
    echo "Hoplite:  http://127.0.0.1:58080"
    echo "Auth:     http://127.0.0.1:59999"
    echo "Signal:   ws://127.0.0.1:58443"
    echo "Postgres: 127.0.0.1:55432"
    ;;
  logs)
    compose logs --follow "$@"
    ;;
  backup)
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    destination="${1:-$repo_root/backups/$timestamp}"
    install -d -m 700 "$destination"
    compose exec --no-TTY postgres pg_dump \
      --username postgres --dbname hestia --format custom \
      --no-owner --file /tmp/hestia.dump
    compose cp postgres:/tmp/hestia.dump "$destination/hestia.dump"
    sha256sum "$destination/hestia.dump" > "$destination/SHA256SUMS"
    echo "Backup: $destination"
    ;;
  restore)
    source_dir="${1:-}"
    confirmation="${2:-}"
    [[ -n "$source_dir" ]] || die "usage: scripts/hestia restore BACKUP_DIR --confirm"
    [[ "$confirmation" == "--confirm" ]] || die "restore replaces local state; add --confirm"
    [[ -f "$source_dir/hestia.dump" && -f "$source_dir/SHA256SUMS" ]] \
      || die "invalid backup directory: $source_dir"
    (cd "$source_dir" && sha256sum --check SHA256SUMS)
    compose up --detach postgres
    compose cp "$source_dir/hestia.dump" postgres:/tmp/hestia-restore.dump
    compose exec --no-TTY postgres pg_restore \
      --username postgres --dbname hestia --clean --if-exists \
      --no-owner /tmp/hestia-restore.dump
    echo "Restored: $source_dir"
    ;;
  help|-h|--help)
    echo "usage: scripts/hestia {init|doctor|up|down|status|logs|backup [DIR]|restore DIR --confirm}"
    ;;
  *)
    die "unknown command: $command"
    ;;
esac
