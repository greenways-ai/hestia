#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/extract-ignatius [--push] TARGET_DIR

Create a history-preserving Ignatius repository from the generic chain sources
currently stored in Hestia.

Requirements:
  - git
  - git-filter-repo
  - a clean Hestia checkout

The command does not push by default. With --push it adds
`git@github.com:greenways-ai/ignatius.git` as origin and pushes main.
EOF
}

push_target=false
case "${1:-}" in
  --push)
    push_target=true
    shift
    ;;
  -h|--help)
    usage
    exit 0
    ;;
esac

target_dir="${1:-}"
if [[ -z "$target_dir" ]]; then
  usage >&2
  exit 2
fi

if ! command -v git >/dev/null 2>&1; then
  echo "error: git is required" >&2
  exit 1
fi

if ! command -v git-filter-repo >/dev/null 2>&1; then
  echo "error: git-filter-repo is required" >&2
  echo "install it with: brew install git-filter-repo" >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  echo "error: run this command from a Hestia git checkout" >&2
  exit 1
fi

if [[ -n "$(git -C "$repo_root" status --porcelain)" ]]; then
  echo "error: the Hestia checkout must be clean before extraction" >&2
  exit 1
fi

case "$target_dir" in
  /*) ;;
  *) target_dir="$(pwd)/$target_dir" ;;
esac

if [[ -e "$target_dir" ]]; then
  echo "error: target already exists: $target_dir" >&2
  exit 1
fi

echo "Cloning Hestia history into $target_dir"
git clone --no-local "$repo_root" "$target_dir"

cd "$target_dir"

git filter-repo --force \
  --path gwdb-ledger/ \
  --path web-components/gw-ledger-sha/ \
  --path web-components/gw-ledger-noir/ \
  --path gwdb-ledger-hal/src/gw/ledger/codec.hal \
  --path gwdb-ledger-hal/src/gw/ledger/runtime.hal \
  --path gwdb-ledger-hal/src/gw/ledger/transaction.hal \
  --path gwdb-ledger-hal/src/gw/ledger/offline.hal \
  --path gwdb-ledger-hal/test/gw/ledger/offline_test.hal \
  --path-rename gwdb-ledger/:db/ \
  --path-rename web-components/gw-ledger-sha/:extensions/sha/ \
  --path-rename web-components/gw-ledger-noir/:extensions/noir/ \
  --path-rename gwdb-ledger-hal/src/gw/ledger/codec.hal:hal/src/ignatius/codec.hal \
  --path-rename gwdb-ledger-hal/src/gw/ledger/runtime.hal:hal/src/ignatius/runtime.hal \
  --path-rename gwdb-ledger-hal/src/gw/ledger/transaction.hal:hal/src/ignatius/transaction.hal \
  --path-rename gwdb-ledger-hal/src/gw/ledger/offline.hal:hal/src/ignatius/client/outbox.hal \
  --path-rename gwdb-ledger-hal/test/gw/ledger/offline_test.hal:hal/test/ignatius/client/outbox_test.hal

git branch -M main

cat > MIGRATION.md <<'EOF'
# Ignatius extraction

This repository was extracted with history from `greenways-ai/hestia`.

The initial extraction deliberately preserves the old `gw.ledger.*` HAL
namespaces inside the moved files. The first Ignatius implementation PR should:

1. create the root project and package metadata;
2. rename generic namespaces to `ignatius.*`;
3. add one-release `gw.ledger.*` compatibility aliases where needed;
4. freeze canonical HCV1, HCP1, transaction, receipt and snapshot fixtures;
5. generate the PostgreSQL SQL artefact from `db/`; and
6. publish the HAL and host client packages consumed by Hestia.

Hestia application modules such as agent authority, rooms and documents were
not included in this extraction.
EOF

git add MIGRATION.md
git commit -m "docs: record Ignatius extraction" >/dev/null

if [[ "$push_target" == true ]]; then
  remote_url="git@github.com:greenways-ai/ignatius.git"
  git remote remove origin 2>/dev/null || true
  git remote add origin "$remote_url"
  git push -u origin main
  echo "Pushed Ignatius to $remote_url"
else
  echo
  echo "Ignatius export created at: $target_dir"
  echo "Review it, create greenways-ai/ignatius, then run:"
  echo "  git -C '$target_dir' remote add origin git@github.com:greenways-ai/ignatius.git"
  echo "  git -C '$target_dir' push -u origin main"
fi
