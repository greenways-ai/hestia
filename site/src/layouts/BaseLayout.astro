---
import "@fontsource/marcellus/400.css";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@greenways-ai/visual-language/theme.css";
import HestiaHeader from "../components/HestiaHeader.astro";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
const site = Astro.site ?? new URL("https://oss.greenways.ai");
const canonical = new URL(Astro.url.pathname, site);
const image = new URL(`${base}assets/og-hestia.jpg`, site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Hestia",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, macOS, Linux",
  description,
  url: canonical.href,
  codeRepository: "https://github.com/greenways-ai/hestia",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  publisher: { "@type": "Organization", name: "Greenways", url: "https://greenways.ai" }
};
---
<!doctype html>
<html lang="en" data-theme="light" data-theme-preference="auto" data-project="hestia">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#050a08" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="An ember mosaic hearth inside Hestia's circular sanctuary" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="An ember mosaic hearth inside Hestia's circular sanctuary" />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script>import "@greenways-ai/visual-language/theme.js";</script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <HestiaHeader homeHref={base} />
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div><span class="wordmark-text">GREENWAYS / HESTIA</span><p>A private office for the agents who work on your behalf.</p></div>
      <nav aria-label="Footer navigation">
        <a href={`${base}rooms/`}>Private Agent Office</a>
        <a href={`${base}recovery-demo/`}>Continuity</a>
        <a href="https://oss.greenways.ai/">Greenways projects</a>
        <a href="https://github.com/greenways-ai/hestia">GitHub ↗</a>
        <a href="mailto:hello@greenways.ai">hello@greenways.ai</a>
      </nav>
      <small>© 2026 Greenways Pty Ltd. Code under Apache-2.0. Greenways marks and artwork reserved.</small>
    </footer>
  </body>
</html>
