---
import DocumentationHeader from "@greenways-ai/visual-language/DocumentationHeader.astro";

type Props = {
  homeHref: string;
};

const { homeHref } = Astro.props;
const base = `${homeHref.replace(/\/+$/, "")}/`;
const searchBase = base.replace(/\/$/, "");
---

<DocumentationHeader
  project="hestia"
  title="Hestia"
  homeHref={base}
  docsHref={`${base}#overview`}
  docsLabel="Docs"
  searchBase={searchBase}
  searchLabel="Search Hestia documentation"
/>
