---
import Sigil from "@greenways-ai/visual-language/Sigil.astro";

type Props = {
  homeHref: string;
  githubHref?: string;
  projectsHref?: string;
};

const {
  homeHref,
  githubHref = "https://github.com/greenways-ai/hestia",
  projectsHref = "https://oss.greenways.ai/"
} = Astro.props;

const links = [
  { label: "Overview", href: `${homeHref}#overview` },
  { label: "Architecture", href: `${homeHref}#architecture` },
  { label: "Extensions", href: `${homeHref}#extensions` },
  { label: "Projects", href: projectsHref },
  { label: "GitHub ↗", href: githubHref, external: true }
];
---
<header class="hestia-header" data-hestia-header>
  <a class="hestia-header__brand" href={homeHref} aria-label="Hestia home">
    <Sigil project="hestia" label="Hestia" class="hestia-header__sigil" />
    <span>Hestia</span>
  </a>

  <nav class="hestia-header__desktop" aria-label="Hestia navigation">
    {links.map((link) => (
      <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined}>{link.label}</a>
    ))}
  </nav>

  <button class="hestia-header__control hestia-header__theme" type="button" data-hestia-theme-toggle title="Toggle light or dark. Shift-click to follow the system theme.">
    <span class="hestia-header__sr">Toggle colour theme</span>
    <svg class="hestia-header__moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z" /></svg>
    <svg class="hestia-header__sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  </button>

  <details class="hestia-header__menu">
    <summary class="hestia-header__control" aria-label="Open navigation">
      <span class="hestia-header__sr">Menu</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </summary>
    <nav aria-label="Compact Hestia navigation">
      {links.map((link) => (
        <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined}>{link.label}</a>
      ))}
    </nav>
  </details>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const buttons = document.querySelectorAll("[data-hestia-theme-toggle]");

    const render = () => {
      const dark = root.dataset.theme === "dark";
      buttons.forEach((button) => {
        button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
        button.setAttribute("aria-pressed", dark ? "true" : "false");
      });
    };

    const fallbackApply = (preference) => {
      const dark = preference === "auto"
        ? window.matchMedia("(prefers-color-scheme: dark)").matches
        : preference === "dark";
      root.dataset.theme = dark ? "dark" : "light";
      root.dataset.themePreference = preference;
      root.style.colorScheme = dark ? "dark" : "light";
      try { localStorage.setItem("gw-theme", preference); } catch {}
    };

    buttons.forEach((button) => {
      button.addEventListener("click", (event) => {
        const current = root.dataset.theme === "dark" ? "dark" : "light";
        const next = event.shiftKey ? "auto" : current === "dark" ? "light" : "dark";
        if (window.GreenwaysTheme?.apply) window.GreenwaysTheme.apply(next, true);
        else fallbackApply(next);
        render();
      });
    });

    document.querySelectorAll("[data-hestia-header] details a").forEach((link) => {
      link.addEventListener("click", () => link.closest("details")?.removeAttribute("open"));
    });

    window.addEventListener("gw-theme-change", render);
    render();
  })();
</script>

<style>
  .hestia-header {
    position: sticky;
    z-index: 60;
    top: 0;
    min-height: 76px;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: clamp(10px, 2vw, 26px);
    padding: 12px clamp(16px, 3vw, 46px);
    color: var(--gw-text);
    background: var(--gw-header);
    border-block: 1px solid var(--gw-line);
    backdrop-filter: blur(18px);
  }

  .hestia-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    font: 400 clamp(1.3rem, 2vw, 1.85rem) Georgia, serif;
    letter-spacing: .075em;
    text-decoration: none;
  }

  .hestia-header__sigil { width: 48px; height: 48px; }

  .hestia-header__desktop {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(13px, 1.7vw, 25px);
  }

  .hestia-header__desktop a,
  .hestia-header__menu nav a {
    color: inherit;
    font: 700 .69rem "Manrope", system-ui, sans-serif;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hestia-header__desktop a:hover,
  .hestia-header__menu nav a:hover { color: var(--gw-accent-3); }

  .hestia-header__control {
    width: 48px;
    height: 48px;
    display: inline-grid;
    place-items: center;
    padding: 0;
    color: var(--gw-control-text);
    background: var(--gw-control-bg);
    border: 1px solid var(--gw-line-strong);
    border-radius: 10px;
    cursor: pointer;
  }

  .hestia-header__control:hover { background: var(--gw-control-hover); }
  .hestia-header__control:focus-visible,
  .hestia-header a:focus-visible { outline: 3px solid var(--gw-focus); outline-offset: 3px; }
  .hestia-header__control svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .hestia-header__moon { display: block; fill: currentColor !important; stroke: none !important; }
  .hestia-header__sun { display: none; }
  :global(:root[data-theme="dark"]) .hestia-header__moon { display: none; }
  :global(:root[data-theme="dark"]) .hestia-header__sun { display: block; }

  .hestia-header__menu { position: relative; display: none; }
  .hestia-header__menu summary { list-style: none; }
  .hestia-header__menu summary::-webkit-details-marker { display: none; }
  .hestia-header__menu nav {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 210px;
    display: grid;
    padding: 8px;
    background: var(--gw-surface);
    border: 1px solid var(--gw-line-strong);
    border-radius: 12px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, .2);
  }
  .hestia-header__menu nav a { padding: 12px; border-radius: 8px; }
  .hestia-header__menu nav a:hover { background: var(--gw-control-hover); }

  .hestia-header__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (max-width: 1080px) {
    .hestia-header { grid-template-columns: auto 1fr auto auto; }
    .hestia-header__desktop { display: none; }
    .hestia-header__menu { display: block; }
  }

  @media (max-width: 560px) {
    .hestia-header { min-height: 68px; padding: 9px 12px; gap: 8px; }
    .hestia-header__sigil { width: 42px; height: 42px; }
    .hestia-header__brand span { font-size: 1.05rem; }
    .hestia-header__control { width: 44px; height: 44px; }
    .hestia-header__menu nav { position: fixed; top: 68px; right: 12px; }
  }
</style>
