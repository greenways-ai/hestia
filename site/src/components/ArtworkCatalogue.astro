---
import ThemedArtwork from "@greenways-ai/visual-language/ThemedArtwork.astro";
const concepts=["sovereign-hearth","protected-threshold","recovery-room","household-archive","secure-correspondence","provision-chamber","sheltered-courtyard","watchful-window","private-sanctuary","fireside-rest"];
const base=`${import.meta.env.BASE_URL.replace(/\/+$/,"")}/`;
---
<section class="gw-catalogue" aria-labelledby="hestia-worlds"><header><p>06 · THE HESTIA WORLD</p><h2 id="hestia-worlds">Ten rooms of<br/>sovereign safety.</h2></header><div>{concepts.map((concept)=><article><ThemedArtwork light={`${base}artwork/hestia/${concept}-day.svg`} dark={`${base}artwork/hestia/${concept}-night.svg`} lightMobile={`${base}artwork/hestia/${concept}-day-mobile.svg`} darkMobile={`${base}artwork/hestia/${concept}-night-mobile.svg`} lightAlt={`${concept.replaceAll("-"," ")} by day`} darkAlt={`${concept.replaceAll("-"," ")} at night`}/><h3>{concept.replaceAll("-"," ")}</h3></article>)}</div></section>
<style>.gw-catalogue{width:min(1320px,calc(100% - 40px));margin:0 auto;padding:120px 0}.gw-catalogue header p{color:var(--ember-bright);font:.7rem var(--mono);letter-spacing:.16em}.gw-catalogue h2{font:400 clamp(3rem,7vw,7rem)/.9 var(--display);margin:18px 0 48px}.gw-catalogue>div{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.gw-catalogue article{overflow:hidden;border:1px solid var(--line);background:var(--surface)}.gw-catalogue article>div{aspect-ratio:16/9}.gw-catalogue h3{margin:0;padding:16px;font:400 1.35rem var(--display);text-transform:capitalize}@media(max-width:680px){.gw-catalogue{width:calc(100% - 24px);padding:70px 0}.gw-catalogue>div{grid-template-columns:1fr}.gw-catalogue article>div{aspect-ratio:3/4}}</style>
