---
import BaseLayout from "../layouts/BaseLayout.astro";
import MosaicMark from "../components/MosaicMark.astro";
import ArtworkCatalogue from "../components/ArtworkCatalogue.astro";
import ThemedArtwork from "@greenways-ai/visual-language/ThemedArtwork.astro";

const title = "Hestia · A private office for your agents";
const description = "Give every agent a role, a bounded key and a signed workflow. Follow work, approve decisions, and share elegant receipts only when you choose.";
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---
<BaseLayout title={title} description={description}>
  <section class="hero" aria-labelledby="hero-title">
    <ThemedArtwork class="hero-art" light={`${base}assets/hestia-greyhound-day.webp`} dark={`${base}assets/hestia-greyhound-night.webp`} lightMobile={`${base}assets/hestia-greyhound-day.webp`} darkMobile={`${base}assets/hestia-greyhound-night.webp`} lightAlt="A greyhound standing beside a garnet couch in a couture winter garden" darkAlt="The greyhound asleep on the garnet couch beside a lit hearth" position="center" />
    <div class="hero-veil"></div>
    <div class="hero-copy section-shell">
      <p class="technical-kicker"><i></i> Private agent office · secured by you</p>
      <h1 id="hero-title">A private office<br />for everything<br />your agents do.</h1>
      <p>Give every agent a named role, a bounded key and a clear workflow. See what has been done on your behalf, approve the moments that matter, and share a polished receipt when a client, partner or adviser asks.</p>
      <div class="hero-actions">
        <a class="action action--ember" href={`${base}rooms/`}>Open the private agent office <span aria-hidden="true">↗</span></a>
        <a class="action" href="#overview">See how it works <span aria-hidden="true">↓</span></a>
        <a class="action" href="https://github.com/greenways-ai/hestia">View source ↗</a>
      </div>
      <div class="hero-command"><code>HESTIA PRIVATE OFFICE</code><span>Private by default · receipts on demand</span></div>
    </div>
    <div class="hero-inscription" aria-hidden="true"><span>APPOINT</span><i></i><span>FOLLOW</span><i></i><span>APPROVE</span><i></i><span>SHARE</span></div>
  </section>

  <section id="overview" class="home-section purpose-section" aria-labelledby="overview-title">
    <header class="section-heading">
      <p class="technical-kicker">01 · Your private agent office</p>
      <div><p class="eyebrow">A well-run house</p><h2 id="overview-title">Keep every agent<br />beautifully in hand.</h2></div>
      <p>Hestia turns a collection of capable agents into a private, legible office. Each agent is known by name, receives only the authority it needs, and works inside mandates that remain visible to you.</p>
    </header>
    <div class="purpose-grid">
      <article><b>01</b><h3>Named agents</h3><p>Maintain a lasting profile for each personal or specialist agent, with a replaceable daily key beneath it.</p></article>
      <article><b>02</b><h3>Bounded mandates</h3><p>State the brief, permitted workflow, spending or action limits, and the decisions that must return to you.</p></article>
      <article><b>03</b><h3>Human approvals</h3><p>Let agents prepare, compare and negotiate while keeping commitments, purchases and final terms under explicit human control.</p></article>
    </div>
  </section>

  <section id="state-chain" class="home-section purpose-section" aria-labelledby="state-chain-title">
    <header class="section-heading">
      <p class="technical-kicker">02 · Work receipts</p>
      <div><p class="eyebrow">Private by default. Presentable on demand.</p><h2 id="state-chain-title">Know what was done.<br />Show only what matters.</h2></div>
      <p>Hestia keeps a private record of briefs, agent work, proposals and approvals. When accountability is requested, it can prepare a bounded receipt that proves the relevant history without opening the rest of your office.</p>
    </header>
    <div class="purpose-grid">
      <article><b>01</b><h3>Signed work trail</h3><p>Every important step can be tied to the agent, mandate, source material and result that produced it.</p></article>
      <article><b>02</b><h3>Exact approvals</h3><p>Your approval binds the precise recommendation, contract or terms you saw—not a later approximation.</p></article>
      <article><b>03</b><h3>Shareable receipts</h3><p>Prepare a client, partner or adviser presentation from selected evidence while the private office remains private.</p></article>
    </div>
  </section>

  <section class="trust-section" aria-labelledby="chain-proof-title">
    <div class="trust-art">
      <picture>
        <source srcset={`${base}assets/hestia-local-ledger.webp`} type="image/webp" />
        <img src={`${base}assets/hestia-local-ledger.jpg`} width="1536" height="1024" loading="lazy" alt="An ember-lit mosaic hearth connected to concentric ledger nodes" />
      </picture>
      <MosaicMark class="trust-mark" label="Hestia private work receipt" />
    </div>
    <div class="trust-copy">
      <p class="technical-kicker"><i></i> 03 · Quiet assurance</p>
      <h2 id="chain-proof-title">The evidence is there<br />when you need it.</h2>
      <p>Most of the time, Hestia should feel like a calm household book: who is working, what they were asked to do, and what is waiting for your attention. Beneath it, every accepted step can carry a durable signature and an independently verifiable root.</p>
      <dl>
        <div><dt>Private record</dt><dd>The complete office history stays with you</dd></div>
        <div><dt>Portable receipt</dt><dd>A selected presentation can travel without exposing unrelated work</dd></div>
        <div><dt>Independent check</dt><dd>A recipient can verify that the presented terms and approvals have not changed</dd></div>
      </dl>
      <a class="action action--ember" href={`${base}rooms/#receipts`}>See a receipt being made ↗</a>
    </div>
  </section>

  <section id="architecture" class="home-section architecture-section" aria-labelledby="architecture-title">
    <header class="section-heading">
      <p class="technical-kicker">04 · Under the surface</p>
      <div><p class="eyebrow">Elegance above, precision below</p><h2 id="architecture-title">A calm interface.<br />A rigorous office.</h2></div>
      <p>Keys, signed workflows and deterministic Hara programs quietly keep agent authority and work history precise, while the surface remains calm, legible and centred on the decisions that deserve your attention.</p>
    </header>
    <div class="architecture-flow" aria-label="Hestia appoints a named agent, gives it a signed mandate, returns decisions for human approval and prepares a selective receipt">
      <span><small>APPOINT</small><b>Named agent</b><em>identity</em></span><i aria-hidden="true">→</i>
      <span><small>MANDATE</small><b>Signed workflow</b><em>authority</em></span><i aria-hidden="true">→</i>
      <span class="architecture-core"><small>APPROVE</small><b>Human decision</b><em>control</em></span><i aria-hidden="true">→</i>
      <span><small>PRESENT</small><b>Work receipt</b><em>accountability</em></span>
    </div>
    <div class="capability-grid">
      <article><span>01</span><strong>Agent keys</strong><p>Each agent has a lasting identity and a replaceable operational key for everyday work.</p></article>
      <article><span>02</span><strong>Workflow signatures</strong><p>Mandates, work entries, recommendations and approvals stay bound to their exact context.</p></article>
      <article><span>03</span><strong>Private history</strong><p>The complete record remains in the owner-controlled office rather than becoming a public activity feed.</p></article>
      <article><span>04</span><strong>Portable proofs</strong><p>Selected receipts can be shared and checked without making a hosted service the source of truth.</p></article>
    </div>
  </section>

  <section id="extensions" class="home-section purpose-section" aria-labelledby="extensions-title">
    <header class="section-heading">
      <p class="technical-kicker">05 · House services</p>
      <div><p class="eyebrow">A complete private office</p><h2 id="extensions-title">Continuity and collaboration,<br />arranged around you.</h2></div>
      <p>The private agent office is the everyday experience. Document provenance and continuity arrangements extend it when you need deeper records, independent stewards or a managed coordination service.</p>
    </header>
    <div class="purpose-grid">
      <article><b>01</b><h3>Private Agent Office</h3><p>Appoint agents, issue mandates, follow work, approve exact terms, rotate access and close an engagement cleanly.</p></article>
      <article><b>02</b><h3>Continuity</h3><p>Arrange independent stewards and an owner-held factor so a lost device does not take the private office with it.</p></article>
      <article><b>03</b><h3>Documents</h3><p>Keep signed versions, provenance and operation histories beside the workflows that created and approved them.</p></article>
    </div>
    <div class="hero-actions">
      <a class="action action--ember" href={`${base}rooms/`}>Open the private agent office ↗</a>
      <a class="action" href={`${base}recovery-demo/`}>Arrange continuity ↗</a>
      <a class="action" href="https://github.com/greenways-ai/hestia/tree/main/docs">Browse the protocols ↗</a>
    </div>
  </section>

  <section id="services" class="trust-section" aria-labelledby="services-title">
    <div class="trust-art">
      <picture>
        <source srcset={`${base}assets/hestia-recovery-keepers.webp`} type="image/webp" />
        <img src={`${base}assets/hestia-recovery-keepers.jpg`} width="1536" height="1024" loading="lazy" alt="Three independent mosaic sanctuary chambers joined around a central circle" />
      </picture>
      <MosaicMark class="trust-mark" label="Greenways concierge services powered by Hestia" />
    </div>
    <div class="trust-copy">
      <p class="technical-kicker"><i></i> 06 · Optional Greenways services</p>
      <h2 id="services-title">Concierge operation.<br />Personal authority.</h2>
      <p>Greenways can make Hestia easier to live with by coordinating continuity ceremonies, invitation delivery and private-agent availability. The service can arrange the room; it does not become the owner of the house.</p>
      <dl>
        <div><dt>Continuity coordination</dt><dd>Steward availability, notifications and ceremony guidance</dd></div>
        <div><dt>Rendezvous & delivery</dt><dd>Agent invitations, presence and blind encrypted relay</dd></div>
        <div><dt>Trust boundary</dt><dd>Your keys, approvals and private work history remain under your control</dd></div>
      </dl>
      <div class="hero-actions">
        <a class="action action--ember" href={`${base}recovery-demo/`}>See the continuity service ↗</a>
        <a class="action" href={`${base}rooms/`}>Enter the private agent office ↗</a>
      </div>
    </div>
  </section>

  <section id="operate" class="operate-section" aria-labelledby="operate-title">
    <picture class="operate-art">
      <source srcset={`${base}assets/hestia-local-ledger.webp`} type="image/webp" />
      <img src={`${base}assets/hestia-local-ledger.jpg`} width="1536" height="1024" loading="lazy" alt="An ember-lit mosaic hearth connected to concentric ledger nodes" />
    </picture>
    <div class="operate-veil"></div>
    <div class="operate-copy section-shell">
      <p class="technical-kicker"><i></i> 07 · Keep it close</p>
      <h2 id="operate-title">Your private office,<br />on your own terms.</h2>
      <p>Use the browser experience, run a personal node, or combine an owner-controlled setup with optional Greenways coordination. The essential arrangement stays the same: agents work through authority you define, and the record belongs to you.</p>
      <pre><code>scripts/hestia init
scripts/hestia doctor
scripts/hestia up</code></pre>
      <dl>
        <div><dt>Everyday experience</dt><dd>Agent roles, mandates, approvals and receipts</dd></div>
        <div><dt>Deployment</dt><dd>Local browser workspace or source-built personal node</dd></div>
        <div><dt>Service layer</dt><dd>Optional coordination without surrendering office authority</dd></div>
      </dl>
      <div class="hero-actions">
        <a class="action action--ember" href={`${base}rooms/`}>Open the live office ↗</a>
        <a class="action" href="https://github.com/greenways-ai/hestia/blob/main/docs/local-node.md">Read the operator guide ↗</a>
      </div>
    </div>
  </section>
  <ArtworkCatalogue />
</BaseLayout>
