(ns hestia.origin)

(defn health
  [request]
  {:status 200
   :headers {"content-type" "application/json; charset=utf-8"
             "cache-control" "no-store"
             "x-hoplite" "hestia"}
   :body "{\"ok\":true,\"protocol\":\"hestia/0-alpha\",\"origin\":\"hoplite\"}\n"})

(defn inspect
  [request]
  {:status 200
   :headers {"content-type" "application/json; charset=utf-8"
             "cache-control" "no-store"}
   :body "{\"service\":\"hestia\",\"security\":\"local-first\",\"ledger\":\"postgresql\"}\n"})
