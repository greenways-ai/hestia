(ns hestia.workflow-v3-test)

(defn workflow-test []
  (let [selected (hestia.workflow-v3/advance
                  (hestia.workflow-v3/initial-state)
                  {"type" "scenario/select" "data" {"scenario" "personal"}})
        creating (hestia.workflow-v3/advance
                  (get selected "state") {"type" "identity/create"})]
    [(= 3 (count (get (get selected "state") "authorities")))
     (= "crypto" (get (nth (get creating "commands") 0) "capability"))
     (= false (get (nth (get (hestia.workflow-v3/view (get selected "state")) "keys") 0)
                   "secret_visible"))]))
