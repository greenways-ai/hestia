;; Hestia continuity workflow for a private agent office.
;; Hara owns the ceremony state and emits capability commands; browser cryptography
;; and any optional coordination service remain replaceable host adapters.
(ns hestia.workflow-v3
  (:require [std.foundation :refer [assoc conj count get merge nth]]))

(def PROGRAM
  {"namespace" "hestia.workflow-v3"
   "version" "0.4.0"
   "title" "Hestia Private Office Continuity"
   "events" ["scenario/select"
             "authorities/select"
             "identity/create"
             "identity/created"
             "factor/secured"
             "education/enrollment-start"
             "education/enrollment-next"
             "identity/lost"
             "recovery/start"
             "authority/approved"
             "recovery/code-entered"
             "education/recovery-start"
             "education/recovery-next"
             "recovery/complete"
             "chat/message"]
   "promise" "Arrange continuity before it is needed, without placing the private office under one service's control."})

(defn program-info [] PROGRAM)

(def PERSONAL
  {"id" "personal"
   "title" "Protect a private agent office"
   "authority_options" [{"id" "notary" "name" "Independent Notary" "required" ["identity-record"]}
                        {"id" "bank" "name" "Private Banking Contact" "required" ["verified-relationship"]}
                        {"id" "contact" "name" "Trusted Steward" "required" ["live-confirmation"]}
                        {"id" "solicitor" "name" "Family Solicitor" "required" ["continuity-mandate"]}
                        {"id" "employer" "name" "Professional Adviser" "required" ["current-engagement"]}
                        {"id" "civic" "name" "Civic Registry" "required" ["civil-record"]}]})

(def ORGANIZATION
  {"id" "organization"
   "title" "Protect an organization signer"
   "authority_options" [{"id" "legal" "name" "Legal Counsel" "required" ["board-resolution"]}
                        {"id" "hr" "name" "People Operations" "required" ["employment"]}
                        {"id" "finance" "name" "Finance Controller" "required" ["signing-authority"]}
                        {"id" "secretary" "name" "Company Secretary" "required" ["company-register"]}
                        {"id" "auditor" "name" "External Auditor" "required" ["audit-engagement"]}
                        {"id" "banking" "name" "Banking Partner" "required" ["account-mandate"]}]})

(defn scenario [id] (if (= id "organization") ORGANIZATION PERSONAL))
(defn command [capability action args]
  {"capability" capability "action" action "args" args})

(defn initial-state []
  {"phase" "choose-scenario" "scenario" nil "identity" nil
   "factor_saved" false "lost" false "authorities" []
   "approvals" [] "chat" [] "enrollment_step" -1 "recovery_step" -1 "error" nil})

(defn key-inventory [state]
  [{"id" "identity" "name" "Private office signing key" "kind" "ECDSA P-256"
    "status" (if (get state "lost") "lost" (if (get state "identity") "active" "not-created"))
    "secret_visible" false}
   {"id" "factor" "name" "Owner-held continuity factor" "kind" "256-bit owner factor"
    "status" (if (get state "factor_saved") "secured-automatically" "not-created")
    "secret_visible" false}
   {"id" "shares" "name" "Steward recovery shares" "kind" "Shamir 2-of-3"
    "status" (if (get state "factor_saved") "distributed" "not-created")
    "secret_visible" false}])

(defn view [state]
  {"phase" (get state "phase") "scenario" (get state "scenario")
   "authority_options" (if (get state "scenario")
                         (get (get state "scenario") "authority_options") [])
   "authorities" (get state "authorities") "approvals" (get state "approvals")
   "approval_count" (count (get state "approvals"))
   "threshold" 2 "chat" (get state "chat")
   "enrollment_step" (get state "enrollment_step")
   "recovery_step" (get state "recovery_step")
   "keys" (key-inventory state) "identity" (get state "identity")})

(defn outcome [state commands]
  {"state" state "view" (view state) "commands" commands})

(defn advance [state event]
  (let [kind (get event "type") data (or (get event "data") {})]
    (cond
      (= kind "scenario/select")
      (let [selected (scenario (get data "scenario"))]
        (outcome (merge state {"phase" "select-authorities" "scenario" selected
                               "authorities" []}) []))
      (= kind "authorities/select")
      (let [chosen (get data "authorities")]
        (if (= 3 (count chosen))
          (outcome (merge state {"phase" "explain-enrollment" "authorities" chosen}) [])
          (throw (ex-info "select exactly three authorities" {"count" (count chosen)}))))
      (= kind "identity/create")
      (outcome (assoc state "phase" "creating-identity")
               [(command "crypto" "create-v3-identity" [])])
      (= kind "identity/created")
      (outcome (merge state {"phase" "save-recovery-code" "identity" data}) [])
      (= kind "factor/secured")
      (outcome (merge state {"phase" "enrollment" "factor_saved" true})
               [(command "crypto" "split-authority-secret" [])])
      (= kind "education/enrollment-start")
      (outcome (assoc state "enrollment_step" 0) [])
      (= kind "education/enrollment-next")
      (let [current (get state "enrollment_step")]
        (outcome (assoc state "enrollment_step" (if (< current 9) (+ current 1) 9)) []))
      (= kind "identity/lost")
      (outcome (merge state {"phase" "lost" "lost" true})
               [(command "crypto" "forget-active-identity" [])])
      (= kind "recovery/start")
      (outcome (assoc state "phase" "collecting-approvals") [])
      (= kind "authority/approved")
      (let [approvals (conj (get state "approvals") (get data "authority"))]
        (outcome (merge state {"approvals" approvals
                               "phase" (if (>= (count approvals) 2)
                                         "enter-recovery-code"
                                         "collecting-approvals")}) []))
      (= kind "recovery/code-entered")
      (outcome (assoc state "phase" "recovering")
               [(command "crypto" "recover-v3-identity" [data])])
      (= kind "education/recovery-start")
      (outcome (assoc state "recovery_step" 0) [])
      (= kind "education/recovery-next")
      (let [current (get state "recovery_step")]
        (outcome (assoc state "recovery_step" (if (< current 7) (+ current 1) 7)) []))
      (= kind "recovery/complete")
      (outcome (merge state {"phase" "recovered" "lost" false}) [])
      (= kind "chat/message")
      (outcome (assoc state "chat" (conj (get state "chat") data))
               [(command "transport" "send-chat" [data])])
      true (throw (ex-info "unknown v3 event" {"type" kind})))))
